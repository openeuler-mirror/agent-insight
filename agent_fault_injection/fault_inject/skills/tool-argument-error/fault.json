{
  "name": "tool-argument-error",
  "skill_name": "ras-tool-argument-error",
  "category": "tool-use",
  "description": "选择正确的原生 order 工具，但将 txt 参数值从 a.txt 错传为 b.txt。",
  "injection_method": "intercept_rewrite",
  "injection": {
    "runtime": [
      {
        "op": "assistant.tool_call.replace_argument",
        "when": {
          "tool": "order",
          "call_index": 1
        },
        "args": {
          "path": "txt",
          "from": "a.txt",
          "to": "b.txt"
        }
      }
    ]
  },
  "tools": [
    "verify_order_argument.py"
  ],
  "agent_tools": [],
  "authoritative_verifier": {
    "command": [
      "python3",
      "{tool:verify_order_argument.py}"
    ],
    "timeout_seconds": 30
  }
}
