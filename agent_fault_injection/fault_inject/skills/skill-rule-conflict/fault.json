      },
      {
        "op": "file.write",
        "path": ".opencode/skills/ras-csv-normalization/SKILL.md",
        "from_asset": "skill-b-csv-normalization.md"
      },
      {
        "op": "file.write",
        "path": ".opencode/skills/ras-csv-analysis-pipeline/SKILL.md",
        "from_asset": "ras-csv-analysis-pipeline.md"
      },
      {
        "op": "file.write",
        "path": "report.csv",
        "from_asset": "report.csv"
      }
    ],
    "runtime": []
  },
  "tools": [
    "csv_conflict_tool.py"
  ],
  "agent_tools": [
    "csv_conflict_tool.py"
  ]
