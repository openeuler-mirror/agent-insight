        "lease_expires_at_ms IS NULL OR lease_expires_at_ms>=0",
        "opencode_session_id IS NULL OR length(opencode_session_id) BETWEEN 1 AND 512",
        "active_request_key IS NULL OR length(active_request_key) BETWEEN 1 AND 512",
        "lease_owner IS NULL OR length(lease_owner) BETWEEN 1 AND 512",
        "(active_request_key IS NULL AND lease_owner IS NULL AND lease_expires_at_ms IS NULL) OR (active_request_key IS NOT NULL AND lease_owner IS NOT NULL AND lease_expires_at_ms IS NOT NULL)"
