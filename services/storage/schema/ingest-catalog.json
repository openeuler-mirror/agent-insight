  ],
  "invariants": [
    "Receipt idempotency is actor and workspace scoped",
    "Artifacts are private durable content-addressed references, no credentials",
    "Plans allocate entity revisions once before sink writes and survive retry",
    "Source revision equality with changed content is quarantined",
    "Trace internal IDs never reused; deleted locators cannot reactivate",
    "Global earliest unsent outbox lease serializes preparation",
    "Accepted actor, packet, receipt identity and trace set are immutable",
    "Plan reference freezes once allocated; indexed and failed states are terminal",
    "Entity identity and creation time immutable; revisions advance exactly one and span source revisions strictly increase",
    "Batch and entity version ledgers cannot be deleted"
  ],
  "runtime_contract": {
    "packet_bytes_max": 4194304,
    "spans_per_packet_max": 4096,
    "normalized_bytes_max": 67108864,
    "default_source_namespace": "otlp",
    "completed_spans_only": true,
    "payload_batch_spans_max": 128,
    "clickhouse_request_bytes_max": 4194304,
    "outbox_event_type": "observability.otlp.accepted.v1",
    "queue_order": "global earliest unsent; active lease or retry delay blocks later events",
    "internal_revision_max": "9223372036854775807",
    "artifact_encodings": [
      "otlp-json/v1",
      "observation-json/v1"
    ],
    "trace_source_revision": 1
  },
