      "checks": [
        "entity_kind IN ('trace','span')",
        "length(entity_id)>0",
        "revision BETWEEN 1 AND 9223372036854775807",
        "source_revision BETWEEN 1 AND 9223372036854775807",
        "length(content_hash)=64",
        "length(artifact_ref)>0",
        "created_at_ms>=0",
