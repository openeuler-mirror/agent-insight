        "length(packet_hash)=64",
        "length(packet_ref)>0",
        "state IN ('accepted','prepared','indexed','failed')",
        "plan_ref IS NULL OR length(plan_ref)>0",
        "length(trace_ids_json)>0",
        "accepted_at_ms>=0",
        "indexed_at_ms IS NULL OR indexed_at_ms>=accepted_at_ms",
        "state<>'prepared' OR plan_ref IS NOT NULL",
        "state<>'indexed' OR (plan_ref IS NOT NULL AND indexed_at_ms IS NOT NULL)"
      ],
