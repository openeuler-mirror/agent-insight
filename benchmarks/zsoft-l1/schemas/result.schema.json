{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "taskId",
    "submissionSha256",
    "bundleDigest",
    "taskDigest",
    "status",
    "success"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "submissionSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "invalid_submission",
        "infrastructure_error"
      ]
    },
    "success": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
