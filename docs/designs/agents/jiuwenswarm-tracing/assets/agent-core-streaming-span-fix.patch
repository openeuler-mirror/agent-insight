+@pytest.mark.asyncio
+async def test_pure_streaming_llm_call_closes_and_exports_span(
+    in_memory_exporter: InMemorySpanExporter,
+) -> None:
+    """A streaming call emitting ONLY LLM_STREAM_* events (no LLM_INVOKE_OUTPUT)
+    must still close and export its llm.call span, with usage populated.
+
+    Regression: the streaming span was opened on LLM_STREAM_INPUT but never
+    ended — the only close path (_close_llm_span) was wired to the
+    non-streaming LLM_INVOKE_OUTPUT event. A real streaming call never fires
+    LLM_INVOKE_OUTPUT, so the span stayed open and no SpanExporter received it
+    (agent-team / streaming runs exported 0 llm.call spans).
+    """
+    fw = Runner.callback_framework
+    messages = [{"role": "user", "content": "stream please"}]
+
+    await fw.trigger(LLMCallEvents.LLM_STREAM_INPUT, messages=messages, model="fake-llm-1")
+    await fw.trigger(
+        LLMCallEvents.LLM_STREAM_OUTPUT, messages=messages, result=_FakeChunk(content="4"),
+    )
+    # Terminal chunk carries finish_reason + usage. Crucially we do NOT fire
+    # LLM_INVOKE_OUTPUT — that is the whole point of the regression.
+    await fw.trigger(
+        LLMCallEvents.LLM_STREAM_OUTPUT, messages=messages, result=_FakeFinalChunk(content="2"),
+    )
+
+    llm_spans = _spans_by_name(in_memory_exporter, "llm.call")
+    assert llm_spans, "streaming llm.call span was never exported (span left unclosed)"
+    span = llm_spans[0]
+    assert _attr(span, "gen_ai.usage.total_tokens") == 19
+    assert _attr(span, "gen_ai.response.finish_reason") == "stop"
+    # streamed deltas accumulated onto the closed span
+    assert _attr(span, "gen_ai.completion.0.content") == "42"
+
+
