-def push_agent_span(agent_id: str, span: Span) -> None:
-    """Push an agent span keyed by agent_id."""
+def push_agent_span(agent_id: str, span: Span, token: Any = None) -> None:
+    """Push an agent span (and its attached OTel context token) keyed by agent_id.
+
+    ``token`` is the value returned by ``context.attach`` when the agent span
+    is attached as the current context, so child LLM/Tool spans nest under it;
+    ``pop_agent_span`` hands it back for the paired ``context.detach``.
+    """
     mapping = dict(_agent_span_map.get())
     bucket = list(mapping.get(agent_id, []))
-    bucket.append(span)
+    bucket.append((span, token))
     mapping[agent_id] = bucket
     _agent_span_map.set(mapping)
 
 
-def pop_agent_span(agent_id: str) -> Span | None:
-    """Pop the most recent open agent span for agent_id, or None."""
+def pop_agent_span(agent_id: str) -> tuple[Span, Any] | None:
+    """Pop the most recent open ``(span, token)`` for agent_id, or None."""
     mapping = dict(_agent_span_map.get())
     bucket = list(mapping.get(agent_id, []))
     if not bucket:
         return None
-    span = bucket.pop()
+    entry = bucket.pop()
     if bucket:
         mapping[agent_id] = bucket
     else:
         mapping.pop(agent_id, None)
