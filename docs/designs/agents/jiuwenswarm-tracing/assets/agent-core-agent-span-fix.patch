diff --git a/tests/unit_tests/agent_teams/observability/test_observability.py b/tests/unit_tests/agent_teams/observability/test_observability.py
index b231b50..5870bd2 100644
--- a/tests/unit_tests/agent_teams/observability/test_observability.py
+++ b/tests/unit_tests/agent_teams/observability/test_observability.py
@@ -537,3 +537,45 @@ async def test_agent_invoke_emits_named_span(
     assert _attr(span, "agentteam.agent.id") == "leader"
     assert _attr(span, "agentteam.agent.input") == "hello"
     assert _attr(span, "agentteam.agent.output") == "acknowledged"
+
+
+@pytest.mark.asyncio
+async def test_child_spans_nest_under_agent_span(
+    in_memory_exporter: InMemorySpanExporter,
+) -> None:
+    """LLM/Tool spans opened during an agent's invoke nest under the agent span.
+
+    Regression: on_agent_invoke_input created the agent span but never attached
+    it as the current OTel context, so child LLM/Tool spans became orphan ROOT
+    spans (own trace, no parent). In agent-team runs this meant per-agent LLM/
+    tool activity could not be attributed to the agent at all.
+    """
+    fw = Runner.callback_framework
+
+    await fw.trigger(
+        AgentEvents.AGENT_INVOKE_INPUT, {"agent_id": "leader", "user_input": "hi"},
+    )
+    # An LLM call (and a tool call) happen INSIDE the agent's invoke.
+    await fw.trigger(
+        LLMCallEvents.LLM_INVOKE_INPUT, messages=[{"role": "user", "content": "x"}], model="fake-llm-1",
+    )
+    await fw.trigger(ToolCallEvents.TOOL_CALL_STARTED, tool_name="calc", tool_id="c1", inputs=((), {}))
+    await fw.trigger(ToolCallEvents.TOOL_CALL_FINISHED, tool_name="calc", tool_id="c1", inputs=((), {}), result=1)
+    await fw.trigger(
+        LLMCallEvents.LLM_INVOKE_OUTPUT, messages=[], result=_FakeAssistantMessage(content="ok"),
+    )
+    await fw.trigger(
+        AgentEvents.AGENT_INVOKE_OUTPUT, {"agent_id": "leader", "user_input": "hi"}, result="done",
+    )
+
+    agent_spans = [s for s in in_memory_exporter.get_finished_spans() if s.name == "agent.leader"]
+    llm_spans = _spans_by_name(in_memory_exporter, "llm.call")
+    tool_spans = _spans_by_name(in_memory_exporter, "tool.calc")
+    assert agent_spans and llm_spans and tool_spans
+    agent_sid = agent_spans[0].context.span_id
+
+    # The LLM span must nest under the agent span (not be an orphan root).
+    assert llm_spans[0].parent is not None, "llm.call is an orphan root — agent span not attached as context"
+    assert llm_spans[0].context.trace_id == agent_spans[0].context.trace_id
+    # Walk the tool span's ancestry up to the agent span (tool nests under llm nests under agent).
+    assert tool_spans[0].context.trace_id == agent_spans[0].context.trace_id
