{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-task/v1",
  "type": "object",
  "required": ["schemaVersion", "benchmark", "context", "task", "workspace", "policy", "submission", "agentConfig"],
  "properties": {
    "execution": {
      "type": "object",
      "required": [
        "profile",
        "environment"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "required": [
            "key",
            "backendKey",
            "sandbox",
            "sourceRevision",
            "implementationDigest",
            "network",
            "resources",
            "timeouts",
            "targets",
            "models",
            "definitionDigest"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "backendKey": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "sandbox": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "sourceRevision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|unknown|unconfigured)$"
            },
            "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "implementationDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "network": {
              "const": "deny"
            },
            "resources": {
              "type": "object",
              "required": [
                "cpu",
                "memoryMiB",
                "pids"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "memoryMiB": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "pids": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                }
              },
              "additionalProperties": false
            },
            "timeouts": {
              "type": "object",
              "required": [
                "prepareSeconds",
                "cleanupSeconds"
              ],
              "properties": {
                "prepareSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "cleanupSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              },
              "additionalProperties": false
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "platform",
                  "agents"
                ],
                "properties": {
                  "platform": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "agents": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^\\s/]+/.+$"
              }
            },
            "definitionDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": [
            "kind",
            "image",
            "arch",
            "workspaceRoot"
          ],
          "properties": {
            "kind": {
              "const": "oci-image"
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?:[a-z0-9][a-z0-9.-]*(?::[0-9]+)?/)?[a-z0-9][a-z0-9._/-]*(?::[A-Za-z0-9_.-]+|@sha256:[a-f0-9]{64})?$"
            },
            "arch": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "workspaceRoot": {
              "type": "string",
              "pattern": "^/(?:[A-Za-z0-9_-]+/?)+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "schemaVersion": { "const": "agent-task/v1" },
    "benchmark": { "type": "object", "required": ["key"] },
    "context": { "type": "object", "required": ["runId", "experimentId", "caseId"] },
    "task": { "type": "object", "required": ["instruction", "benchmarkPayload"] },
    "workspace": {
      "oneOf": [
        {
          "type": "object", "required": ["provider", "repository", "revision"],
          "properties": {
            "provider": { "const": "git" }, "repository": { "type": "string" },
            "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["provider", "taskId", "digest"],
          "properties": {
            "provider": { "const": "public-bundle" }, "taskId": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["provider", "taskId"],
          "properties": {
            "provider": { "const": "zsoft-tasks" },
            "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          }, "additionalProperties": false
        }
      ]
    },
    "policy": { "type": "object", "required": ["workspaceWrite", "hiddenDataAccess", "network"] },
    "submission": {
      "type": "object",
      "required": ["requiredArtifacts"],
      "properties": {
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "mediaType", "collector", "maxBytes"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "mediaType": { "type": "string", "minLength": 1 },
              "collector": { "type": "string", "minLength": 1 },
              "maxBytes": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agentConfig": {
      "type": "object",
      "required": ["platform", "agent", "timeoutSeconds"],
      "properties": {
        "executionProfile": { "type": "object" },
        "executionArch": { "enum": ["amd64", "arm64"] },
        "platform": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "executionConcurrency": { "type": "integer", "minimum": 1 },
        "agentOptions": {
          "oneOf": [
            {
              "type": "object",
              "required": ["runtimeKey", "definitionDigest", "values"],
              "properties": {
                "runtimeKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
                "definitionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "values": {
                  "type": "object",
                  "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
                  "additionalProperties": { "type": ["string", "number", "boolean"] }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["version", "runtimeKey", "definitionDigest", "values"],
              "properties": {
                "version": { "const": 2 },
                "runtimeKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
                "definitionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "values": { "$ref": "#/$defs/jsonObject" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["__proto__", "prototype", "constructor"] } },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  }
}
