{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-task/v1",
  "type": "object",
  "required": ["schemaVersion", "benchmark", "context", "task", "workspace", "policy", "submission", "agentConfig"],
  "properties": {
    "schemaVersion": { "const": "agent-task/v1" },
    "benchmark": { "type": "object", "required": ["key"] },
    "context": { "type": "object", "required": ["runId", "experimentId", "caseId"] },
    "task": { "type": "object", "required": ["instruction", "benchmarkPayload"] },
    "workspace": {
      "oneOf": [
        {
          "type": "object", "required": ["provider", "repository", "revision"],
          "properties": {
            "provider": { "const": "git" }, "repository": { "type": "string" },
            "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["provider", "taskId", "digest"],
          "properties": {
            "provider": { "const": "public-bundle" }, "taskId": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["provider", "taskId"],
          "properties": {
            "provider": { "const": "zsoft-tasks" },
            "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          }, "additionalProperties": false
        }
      ]
    },
    "policy": { "type": "object", "required": ["workspaceWrite", "hiddenDataAccess", "network"] },
    "submission": {
      "type": "object",
      "required": ["requiredArtifacts"],
      "properties": {
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "mediaType", "collector", "maxBytes"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "mediaType": { "type": "string", "minLength": 1 },
              "collector": { "type": "string", "minLength": 1 },
              "maxBytes": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agentConfig": {
      "type": "object",
      "required": ["platform", "agent", "timeoutSeconds"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "executionConcurrency": { "type": "integer", "minimum": 1 },
        "agentOptions": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
