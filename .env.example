# ============================================================
# Agent Insight 环境配置
# ============================================================
# 平台配置文件：$AGENT_INSIGHT_HOME/.env；运行根默认 $HOME/.agent-insight。
# 首次使用：mkdir -p ~/.agent-insight && cp .env.example ~/.agent-insight/.env
# 修改平台配置后重启服务；NEXT_PUBLIC_URL_PREFIX 还需要重新构建前端。
# 未注释的赋值可直接用于平台；以“# NAME=”表示的可选项需按说明启用。
# Evaluator / 执行客户端配置位于末尾，均为其他进程的参考示例，不会由平台代为应用。
# AGENT_INSIGHT_HOME 在启动命令 / systemd / Docker 环境中设置，不在本文件设置。
# 旧 AGENT_INSIGHT_DATA_DIR 和 PORT 已移除；前者改为 AGENT_INSIGHT_HOME（保留原根路径），
# 后者按进程改为 AGENT_INSIGHT_PORT / AGENT_INSIGHT_EVALUATOR_PORT。
# 密钥和部署地址仅填写在本机实际配置中；本模板不得包含真实凭据或内部地址。

# ------------------------------------------------------------
# 平台监听与数据库
# ------------------------------------------------------------
# 平台 HTTP 监听端口；默认 3000，整数 1～65535；启动参数 --port 可覆盖本次启动。
AGENT_INSIGHT_PORT=3000
# Evaluator 宿主机映射端口；默认 3001，整数 1～65535；评测启动脚本 --port 可覆盖。
AGENT_INSIGHT_EVALUATOR_PORT=3001
# SQLite 连接地址；留空使用 $AGENT_INSIGHT_HOME/data/witty_insight.db。
# 显式覆盖示例：file:/srv/agent-insight/data/witty_insight.db。
DATABASE_URL=

# OpenGauss 可选配置：仅 DB_HOST 非空时启用，否则继续使用 SQLite。
# 数据库主机地址；无默认值，启用 OpenGauss 时必填。
# DB_HOST=
# 数据库端口；建议显式填写，平台默认 5432，初始化脚本默认 26000，需与实际实例一致。
# DB_PORT=26000
# 数据库名称；默认 postgres。
# DB_NAME=postgres
# 数据库用户；默认 omm。
# DB_USER=omm
# 数据库密码；无默认值，仅填写在实际部署配置中。
# DB_PASSWORD=

# ------------------------------------------------------------
# 默认模型（可选，平台侧）
# ------------------------------------------------------------
# 按 DEFAULT_MODEL_<N>_<FIELD> 连续编号，从 1 开始；某组 NAME / PROVIDER / API_KEY
# 缺失时停止读取后续组。环境配置在 UI 中只读；用户仍可在 UI 中创建自己的模型配置。
# 以下是两组格式示例；使用时替换地址、模型与密钥，再取消该组注释。
# 第 1 组显示名称；必填，含空格时使用引号。
# DEFAULT_MODEL_1_NAME="Example Model"
# 第 1 组提供商；必填，支持 deepseek / openai / anthropic / siliconflow / custom。
# DEFAULT_MODEL_1_PROVIDER=custom
# 第 1 组 API 密钥；必填，无默认值。
# DEFAULT_MODEL_1_API_KEY=
# 第 1 组 API 基础地址；建议显式填写实际地址，尤其是自建或代理服务。
# 留空时由各调用路径兜底，不会统一按 PROVIDER 自动选择地址。
# DEFAULT_MODEL_1_BASE_URL=https://api.example.com/v1
# 第 1 组模型名称；建议显式填写实际模型，不保证按 PROVIDER 自动补齐。
# DEFAULT_MODEL_1_MODEL=example-model

# 第 2 组显示名称；填写前须先完整配置第 1 组。
# DEFAULT_MODEL_2_NAME="Another Model"
# 第 2 组提供商；枚举与第 1 组相同。
# DEFAULT_MODEL_2_PROVIDER=custom
# 第 2 组 API 密钥；必填，无默认值。
# DEFAULT_MODEL_2_API_KEY=
# 第 2 组 API 基础地址；可选，含义与第 1 组相同。
# DEFAULT_MODEL_2_BASE_URL=https://another-api.example.com/v1
# 第 2 组模型名称；可选，含义与第 1 组相同。
# DEFAULT_MODEL_2_MODEL=another-example-model

# ------------------------------------------------------------
# 网络、URL 与客户端下载（平台侧）
# ------------------------------------------------------------
# 出站 HTTP 代理；默认不设置，由支持代理的请求和子进程读取。
# HTTP_PROXY=http://proxy.example.com:8080
# 出站 HTTPS 代理；默认不设置，优先级高于 HTTP_PROXY。
# HTTPS_PROXY=http://proxy.example.com:8080
# 无需走代理的主机列表；逗号分隔，可兼用 NO_PROXY，建议保留本机地址。
# no_proxy=localhost,127.0.0.1
# Node.js TLS 证书校验；默认 1，0 会关闭校验，仅用于受控的自签名证书环境。
# NODE_TLS_REJECT_UNAUTHORIZED=1

# 平台访问路径前缀；默认空，例如 /skill-insight；同时影响页面路径和 API。
# 属于构建配置，修改后需重新构建并重启；预构建产物需使用匹配此前缀的版本。
NEXT_PUBLIC_URL_PREFIX=
# Qoder JetBrains 插件 Release 附件直链；默认使用源码内置发布地址。
# 仅在改用官方新地址、镜像或私有制品仓时设置；应指向可信 ZIP 附件。
# AGENT_INSIGHT_QODER_JETBRAINS_PACKAGE_URL=https://downloads.example.com/agent-insight-qoder-jetbrains.zip

# ------------------------------------------------------------
# 平台登录：standalone / idaas_oauth
# ------------------------------------------------------------
# 登录模式；默认 standalone（本地邮箱登录）；idaas_oauth 为独立 OAuth 授权码登录。
LOGIN_MODE=standalone
# OAuth 以下 7 项均无默认值，仅 LOGIN_MODE=idaas_oauth 时必填。
# IDaaS 授权页面的完整 HTTP(S) 地址。
IDAAS_OAUTH_AUTHORIZATION_URL=
# IDaaS 换取 access token 的完整 HTTP(S) 地址。
IDAAS_OAUTH_TOKEN_URL=
# IDaaS 查询当前用户信息的完整 HTTP(S) 地址。
IDAAS_OAUTH_USERINFO_URL=
# IDaaS 分配的平台应用客户端标识。
IDAAS_OAUTH_CLIENT_ID=
# IDaaS 分配的客户端密钥；仅填写在实际部署配置中。
IDAAS_OAUTH_CLIENT_SECRET=
# OAuth 回调完整地址，须以 /callback 结尾并与 IDaaS 登记值一致。
# 兼容 /api/auth/idaas-oauth/callback 路径。
IDAAS_OAUTH_REDIRECT_URI=
# OAuth 授权范围；由 IDaaS 提供，无默认值，多个 scope 按其协议分隔。
IDAAS_OAUTH_SCOPE=

# 地区访问限制，仅 idaas_oauth 登录生效；默认 false（关闭）。
IDAAS_REGION_ACCESS_ENABLED=false
# 服务端获取 IAM token 的完整 HTTP(S) 地址；启用地区限制时必填。
IDAAS_REGION_ACCESS_IAM_URL=
# 通过 UUID / 主管编号查询人员地区信息的完整 HTTP(S) 地址；启用时必填。
IDAAS_REGION_ACCESS_PERSON_URL=
# IAM token 请求的项目 / 租户标识；启用时填部署方分配值。
IDAAS_REGION_ACCESS_IAM_PROJECT=
# IAM 服务账号；启用时必填，非平台登录用户账号。
IDAAS_REGION_ACCESS_IAM_ACCOUNT=
# IAM 服务账号密钥；启用时必填，禁止在模板中提交真实值或密文。
IDAAS_REGION_ACCESS_IAM_SECRET=
# IAM token 请求的企业 / 租户标识；启用时填部署方分配值。
IDAAS_REGION_ACCESS_IAM_ENTERPRISE=
# 地区 IAM / 人员接口是否校验 TLS 证书；当前默认 false，可信证书部署建议设 true。
# 此项只作用于地区接口，不影响其他平台请求。
IDAAS_REGION_ACCESS_TLS_VERIFY=false

# ------------------------------------------------------------
# 历史组织集成（存量平台部署，与 IDaaS OAuth 不同）
# ------------------------------------------------------------
# 默认 false；true 启用上游网关 Cookie 与组织 Skill 接口，不与 idaas_oauth 同时启用。
ORGANIZATION_MODE=false
# 历史组织用户信息接口完整地址；无默认值，启用组织集成时填写。
ORG_USER_INFO_URL=
# 历史组织登录页完整地址；直接访问平台 /login 时跳转，无默认值。
ORG_LOGIN_REDIRECT_URL=
# 组织 Skill 清单接口完整地址；执行组织同步时必填。
ORG_SKILL_LIST_URL=
# 查询 Skill 下载地址的 URL 模板；以 {id} 表示组织 Skill ID，无默认值。
ORG_SKILL_DOWNLOAD_URL=
# 删除组织 Skill 的 URL 模板；以 {id} 表示组织 Skill ID，无默认值。
ORG_SKILL_DELETE_URL_BASE=
# 查询组织 Skill 详情的 URL 模板；以 {id} 表示组织 Skill ID，无默认值。
ORG_SKILL_INFO_URL=

# ------------------------------------------------------------
# Langfuse 调用追踪（可选，平台侧）
# ------------------------------------------------------------
# Langfuse 项目公钥；默认空，需与私钥同时配置才启用 LangChain 回调追踪。
LANGFUSE_PUBLIC_KEY=
# Langfuse 项目私钥；默认空，仅填写在实际部署配置中。
LANGFUSE_SECRET_KEY=
# Langfuse API 基础地址；留空使用 SDK 配置中的欧洲云地址，可填写自建实例地址。
LANGFUSE_BASE_URL=

# ------------------------------------------------------------
# Benchmark 调度与数据准备（平台侧）
# ------------------------------------------------------------
# 下列 3 项是进程启动兜底值；运行后可通过
# $AGENT_INSIGHT_HOME/data/config/benchmark-evaluator.env 热更新，无需重启平台。
# 旧版本地执行器回调地址覆盖；默认空，从请求地址自动推导。
AGENT_INSIGHT_BENCHMARK_EXECUTOR_CALLBACK_BASE_URL=
# 独立 Evaluator 的基础地址；默认空，配置后平台向其下发任务。
# 本机开发示例：http://127.0.0.1:3001；远端请填写部署地址。
AGENT_INSIGHT_BENCHMARK_EVALUATOR_BASE_URL=
# 是否允许非回环 HTTP 地址；默认 true，依赖网络隔离；false 要求非回环地址使用 HTTPS。
AGENT_INSIGHT_BENCHMARK_EVALUATOR_ALLOW_INSECURE_HTTP=true

# 启动时自动准备的 Benchmark；默认空（不准备），当前支持 swe-bench。
# 启动参数 --benchmark swe-bench 可覆盖本次启动。
AGENT_INSIGHT_BENCHMARK=
# SWE-bench Verified 数据集来源；默认空使用官方来源，支持 HTTP(S) 直链或本机文件。
# 示例：https://datasets.example.com/test.parquet 或 /srv/datasets/test.parquet。
# 自定义来源仍须通过固定的官方 SHA-256 校验，已导入数据优先复用。
SWE_BENCH_DATASET_SOURCE=
# SWE-bench Harness 源码归档来源；默认空使用官方来源，支持 HTTP(S) 直链或本机文件。
# 示例：https://datasets.example.com/source.tar.gz；不是 Case Git 仓库，亦需校验 SHA-256。
SWE_BENCH_SOURCE_ARCHIVE_SOURCE=
# 官方 SWE-bench Loader 使用的 Python 可执行文件绝对路径；留空自动创建所需环境。
SWE_BENCH_PYTHON=

# 单用户跨实验评测并发上限；默认空跟随 Evaluator 总并发，显式设置时须为正整数。
AGENT_INSIGHT_BENCHMARK_EVAL_MAX_CONCURRENCY_PER_USER=
# 全平台执行中或待评测 Case 上限；默认 256，正整数；达到上限暂停启动新 Case。
AGENT_INSIGHT_BENCHMARK_MAX_PENDING_EVALUATIONS=256
# 每用户执行中或待评测 Case 上限；默认 128，正整数；已有任务继续，未启动 Case 不计入。
AGENT_INSIGHT_BENCHMARK_MAX_PENDING_EVALUATIONS_PER_USER=128

# ------------------------------------------------------------
# 性能与平台管理（平台侧）
# ------------------------------------------------------------
# Trace 列表加载交互与结果明细时每批的条数；默认 100。
# 调小可降低峰值内存，调大会减少查询次数；不改变返回结果。
READ_RECORDS_HYDRATE_BATCH_SIZE=100
# 管理员用户名白名单；逗号分隔；留空时模型单价管理默认仅 admin 可写。
# 用量统计要求此项显式非空，否则所有用户均无权访问；示例：admin,operator@example.com。
AGENT_INSIGHT_ADMIN_USERS=
# 用量统计开关；默认 0，1 开启；只记录用户主动操作到达成功边界的事件。
# 开启前执行部署压测（scripts/benchmark_usage_analytics.ts）；不会统计轮询或后台重试。
AGENT_INSIGHT_USAGE_ENABLED=0
# 用量统计原始事件保留天数；默认 365，小于 1 或非法值回退默认；日聚合永久保留。
AGENT_INSIGHT_USAGE_RAW_RETENTION_DAYS=365

# ------------------------------------------------------------
# 服务端运行缓存清理（平台侧；修改实际 .env 后重启生效）
# ------------------------------------------------------------
# 仅清理运行日志、接收缓存和确认失效的临时 HOME，保留 Trace / 评测 / 诊断等业务数据。
# 日志只按时间和大小轮转、删除旧文件，不读取日志正文或压缩。
# 数字按整数读取；空值 / 非法值 / 低于下限回退默认，高于上限取上限。
# 总开关；默认 1，0 关闭；也支持 true / false。
AGENT_INSIGHT_CLEANUP_ENABLED=1
# 预演开关；默认 0；1 仅扫描，不删除、轮转或写清理标记，也支持 true / false。
AGENT_INSIGHT_CLEANUP_DRY_RUN=0
# 每次服务启动后首次清理的延迟，单位毫秒；默认 60000；范围 30000～86400000。
AGENT_INSIGHT_CLEANUP_STARTUP_DELAY_MS=60000
# 完整一轮结束到下一轮开始的间隔，单位毫秒；默认 3600000；范围 60000～86400000。
AGENT_INSIGHT_CLEANUP_INTERVAL_MS=3600000
# 同一轮中两批之间的休息时间，单位毫秒；默认 5000；范围 1000～60000。
AGENT_INSIGHT_CLEANUP_PAUSE_MS=5000
# 每批扫描操作数上限；默认 100；范围 1～1000；一步不等于一个完整文件。
AGENT_INSIGHT_CLEANUP_MAX_STEPS=100
# 每批时间预算，单位毫秒；默认 50；范围 1～250；单次 I/O 完成后检查，非硬超时。
AGENT_INSIGHT_CLEANUP_SLICE_MS=50
# 每批缓存读取量预算，单位字节；默认 1048576（1 MiB）；范围 65536～16777216。
# 用于旧缓存的会话归属解析等；少量锁元数据读取另计，单次读取块完成后检查。
# 与操作数、时间预算任一先达到即暂停；日志清理不消耗正文读取量。
AGENT_INSIGHT_CLEANUP_MAX_READ_BYTES=1048576
# 正常结束且已成功落库的原始缓存保留天数；默认 7；范围 1～3650。
# 从结束时间与最后实际接收时间中较晚者起算，正在使用的缓存跳过。
AGENT_INSIGHT_OTEL_SPOOL_RETENTION_DAYS=7
# 失败、未处理或长期失活缓存保留天数；默认 14；范围 1～3650。
# 若小于正常保留天数则提升为正常天数；按实际接收时间计算，服务端重试不续期。
AGENT_INSIGHT_CLEANUP_ABNORMAL_DAYS=14
# 应用日志输出与清理共用的目录；默认 /var/log/agent-insight，服务进程需有读写权限。
AGENT_INSIGHT_LOG_DIR=/var/log/agent-insight
# 轮转后的日志保留天数；默认 14；范围 1～3650；从轮转时间起算，超期整文件删除。
AGENT_INSIGHT_CLEANUP_LOG_RETENTION_DAYS=14
# 活动日志轮转时间阈值，单位小时；默认 24；范围 1～8760；在后台扫描时检查。
AGENT_INSIGHT_CLEANUP_LOG_ROTATE_HOURS=24
# 活动日志轮转大小阈值，单位字节；默认 52428800（50 MiB）；范围 1024～1099511627776。
# 与轮转时间任一达到即轮转；扫描间隔内文件可能暂时超过该值。
AGENT_INSIGHT_CLEANUP_LOG_MAX_FILE_BYTES=52428800
# 活动与历史日志总量软目标，单位字节；默认 1073741824（1 GiB）；范围 1048576～1099511627776。
# 超出时按轮转时间删除最旧归档；不删除活动文件，当轮刚轮转的文件留待后续轮次。
# 若小于单文件轮转阈值则提升为单文件阈值，轮次之间可能暂时超出目标。
AGENT_INSIGHT_CLEANUP_LOG_MAX_TOTAL_BYTES=1073741824
# 临时 HOME 最小保留时间，单位小时；默认 24；范围 1～8760；从创建时间起算。
# 同时要求登记的服务进程和子进程组均已退出；活跃或无法确认所有权的目录跳过。
AGENT_INSIGHT_CLEANUP_TEMP_RETENTION_HOURS=24

# ------------------------------------------------------------
# 执行客户端参考（不由平台进程消费）
# ------------------------------------------------------------
# 在执行客户端所在机器的环境 / 对应工具配置中设置，不要仅在平台机取消注释。
# MCTS Benchmark 执行客户端配置（在实际执行 MCTS 的机器上填写绝对路径）
# 常驻客户端启动时读取 $AGENT_INSIGHT_HOME/.env；进程环境变量优先。
# 仓库路径必填；其他两项留空时使用仓库内 .venv/bin/python 和标准采集器位置。
AGENT_INSIGHT_MCTS_REPO_DIR=
AGENT_INSIGHT_MCTS_PYTHON=
AGENT_INSIGHT_MCTS_TRACE_LAUNCHER=

# 平台颁发的 API Key；无默认值，用于采集上报和 Skill 同步的身份 / 用户隔离。
# WITTY_INSIGHT_API_KEY=
# SWE-bench Case Git 来源；在执行客户端的进程环境或其运行根 .env 中设置。
# 留空默认 Gitee → GitHub，不使用持久缓存；绝对目录启用本地 Bare 缓存，
# HTTP(S) Git 根地址则按 root/owner/repo.git 拉取，再回退 Gitee → GitHub；不接受 tar.gz。
# SWE_BENCH_GIT_SOURCE=

# ------------------------------------------------------------
# Evaluator 参考（独立评测进程，不由平台 .env 应用）
# ------------------------------------------------------------
# 本节仅保留注释示例。使用 scripts/evaluator.sh start --evaluator-env NAME=VALUE 传入；
# 修改后重建 / 重启 Evaluator 容器。平台 .env 仅供启动脚本读取宿主映射端口。
# 容器内部固定监听 8080；通过 --port / AGENT_INSIGHT_EVALUATOR_PORT 改宿主端口。
# 以下基础参数仅供直接运行服务时参考，官方启动脚本会自动设置它们。
# Evaluator 内部监听地址；直接运行默认 0.0.0.0，官方容器需保持该值。
# EVALUATOR_LISTEN_HOST=0.0.0.0
# Evaluator 内部端口；直接运行默认 8080，官方脚本不接受通过 --evaluator-env 覆盖。
# EVALUATOR_PORT=8080
# Evaluator 数据目录；默认 /data，官方脚本挂载此目录以持久化评测数据。
# EVALUATOR_DATA_DIR=/data
# Evaluator 总评测并发；默认 1，必须为正整数，可通过 --evaluator-env 覆盖。
# EVALUATOR_MAX_CONCURRENCY=1

# 镜像池开关；默认 true，false 关闭镜像池及预取；通过 --evaluator-env 设置。
# IMAGE_POOL_ENABLED=true
# 镜像提前预取开关；默认 true，仅镜像池开启时生效。
# IMAGE_POOL_PREFETCH_ENABLED=true
# 镜像池安全保留比例；默认 0.3，即可用空间与池内镜像占用之和的 30%；范围 (0,1)。
# IMAGE_POOL_RESERVE_RATIO=0.3
# 镜像池高水位比例；默认 0.9，池内占用与预留量达到容量的此比例时触发回收；范围 (0,1)。
# IMAGE_POOL_HIGH_WATERMARK=0.9
# 最大并行拉取数；默认 2，整数 1～8；开启预取时至少为 2。
# IMAGE_POOL_MAX_PULLS=2
# 镜像准备最长等待时间；默认 600 秒；正数且不超过 86400 秒。
# IMAGE_POOL_WAIT_SECONDS=600
# macOS Docker.raw 同文件系统上的空共享目录；默认评测管理目录下的 space-probe。
# 仅启动脚本消费，必须用 --evaluator-env 传入；不会移动 Docker 磁盘映像。
# IMAGE_POOL_MAC_DISK_PATH=

# SWE-bench 镜像来源；默认 official，可选 epoch（仅用于显式许可的 ARM64 smoke）。
# SWE_BENCH_IMAGE_SOURCE=official
# SWE-bench 镜像架构；默认 auto 跟随 Docker daemon，可选 x86_64 / arm64，必须与 daemon 一致。
# SWE_BENCH_IMAGE_ARCH=auto
# 是否允许非官方镜像；默认 false；true 仅放行 ARM64 Epoch smoke，不计正式评测。
# SWE_BENCH_ALLOW_NON_OFFICIAL=false

# EVALUATOR_HOST_OS、EVALUATOR_HOST_ARCH、EVALUATOR_SOURCE_REVISION、
# EVALUATOR_SOURCE_DIRTY、EVALUATOR_CONTROLLER_IMAGE_ID 是启动 / 构建脚本注入的事实，
# 不属于用户配置项，不要手工设置。
