# ============================================================
# Witty-Skill-Insight 环境配置
# ============================================================
# 默认配置统一写入 $AGENT_INSIGHT_HOME/.env；运行根默认 $HOME/.agent-insight
# AGENT_INSIGHT_HOME 应在启动命令 / systemd / Docker 环境中设置，不在此文件设置。
# 旧 AGENT_INSIGHT_DATA_DIR 已移除，非空会报错；改名后保留原根路径，不追加 /data。
# mkdir -p ~/.agent-insight && cp .env.example ~/.agent-insight/.env

# ------------------------------------------------------------
# 数据库配置（可选）
# ------------------------------------------------------------
# 留空时使用 $AGENT_INSIGHT_HOME/data/witty_insight.db；默认 HOME 为 $HOME/.agent-insight
# 也可只对单次启动覆盖：DATABASE_URL="file:/tmp/agent-insight-test.db" bash scripts/start.sh
DATABASE_URL=

# 平台对外监听端口；留空时使用 3000。单次覆盖：bash scripts/start.sh --port 3100
# 旧 PORT 已移除，请将已有配置改名，不要同时设置 PORT。
AGENT_INSIGHT_PORT=
# 评测服务宿主机对外端口；留空时使用 3001。单次覆盖：bash scripts/start-evaluator.sh --port 3101
AGENT_INSIGHT_EVALUATOR_PORT=

# opengauss数据库配置（可选，配置后将使用 OpenGauss，否则使用 SQLite）
# DB_HOST=
# DB_PORT=
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=

# ------------------------------------------------------------
# 默认模型配置（可选）
# ------------------------------------------------------------
# 支持配置多个模型，按编号 1, 2, 3... 递增
# 格式：DEFAULT_MODEL_<N>_<FIELD>
#
# 可用字段：
# - NAME: 配置名称
# - PROVIDER: 提供商 (deepseek | openai | anthropic | siliconflow | custom)
# - API_KEY: API 密钥
# - BASE_URL: API 基础 URL（可选）
# - MODEL: 模型名称
#
# 注意：
# - 环境变量配置是只读的，不能在 UI 中修改或删除
# - 用户可以在 UI 中创建自己的配置
# - 服务启动时会自动激活第一个默认配置
#
# 示例：
# DEFAULT_MODEL_1_NAME=DeepSeek Default
# DEFAULT_MODEL_1_PROVIDER=deepseek
# DEFAULT_MODEL_1_API_KEY=sk-xxx
# DEFAULT_MODEL_1_BASE_URL=https://api.deepseek.com
# DEFAULT_MODEL_1_MODEL=deepseek-v4-flash
#
# DEFAULT_MODEL_2_NAME=OpenAI Proxy
# DEFAULT_MODEL_2_PROVIDER=custom
# DEFAULT_MODEL_2_API_KEY=sk-yyy
# DEFAULT_MODEL_2_BASE_URL=https://api.openai.com/v1
# DEFAULT_MODEL_2_MODEL=gpt-4o


# ------------------------------------------------------------
# API Key（可选）
# ------------------------------------------------------------
# Dashboard 颁发的 API Key，用于：
# 1. 采集脚本向 Dashboard 上报数据时的身份识别
# 2. Skill 同步时的用户隔离
# 可在看板右上角生成
# WITTY_INSIGHT_API_KEY=sk-xxxx

# Qoder for JetBrains 已编译插件的受信任 Release 附件直链（可选覆盖）。
# 源码内置贡献分支 Release 默认地址；迁移到官方 Release、镜像或私有制品仓时配置此项。
# AGENT_INSIGHT_QODER_JETBRAINS_PACKAGE_URL=https://example.com/releases/agent-insight-qoder-jetbrains.zip

# ------------------------------------------------------------
# 网络代理（可选，企业内网环境可能需要）
# ------------------------------------------------------------
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# no_proxy=localhost,127.0.0.1

# SSL 证书校验（仅在自签名证书环境下设为 0）
# NODE_TLS_REJECT_UNAUTHORIZED=1

# ------------------------------------------------------------
# 平台登录模式
# ------------------------------------------------------------
# standalone：默认本地邮箱登录
# idaas_oauth：使用独立的 IDaaS OAuth 2.0 授权码登录
LOGIN_MODE=standalone

# IDaaS OAuth 登录配置（仅 LOGIN_MODE=idaas_oauth 时必填）
# 所有真实地址、客户端标识和密钥只写入部署环境，不要提交到代码仓
IDAAS_OAUTH_AUTHORIZATION_URL=
IDAAS_OAUTH_TOKEN_URL=
IDAAS_OAUTH_USERINFO_URL=
IDAAS_OAUTH_CLIENT_ID=
IDAAS_OAUTH_CLIENT_SECRET=
# 推荐以 /callback 结尾；兼容 /api/auth/idaas-oauth/callback，并与 IDaaS 登记值完全一致
IDAAS_OAUTH_REDIRECT_URI=
IDAAS_OAUTH_SCOPE=
# IDaaS 地区访问限制（可选；仅 LOGIN_MODE=idaas_oauth 时生效）
# 是否启用地区访问限制；默认关闭，外部部署不受影响
IDAAS_REGION_ACCESS_ENABLED=false

# 获取服务端 IAM access token 的完整 HTTP(S) 地址
IDAAS_REGION_ACCESS_IAM_URL=

# 使用 UUID 或主管编号查询人员信息的完整 HTTP(S) 地址
IDAAS_REGION_ACCESS_PERSON_URL=

# IAM token 请求使用的项目/租户标识；填写部署方分配值
IDAAS_REGION_ACCESS_IAM_PROJECT=

# IAM token 请求使用的服务账号；不是登录用户账号
IDAAS_REGION_ACCESS_IAM_ACCOUNT=

# IAM 服务账号密钥；只写入部署环境，禁止提交真实值或密文
IDAAS_REGION_ACCESS_IAM_SECRET=

# IAM token 请求使用的企业/租户标识；填写部署方分配值
IDAAS_REGION_ACCESS_IAM_ENTERPRISE=

# 是否校验地区 IAM/人员接口的 TLS 证书；false 仅适用于受控内网证书环境
IDAAS_REGION_ACCESS_TLS_VERIFY=false


# ------------------------------------------------------------
# 历史组织集成配置（可选，与 IDaaS OAuth 登录不同）
# ------------------------------------------------------------
# 此模式依赖上游网关 Cookie 和组织 Skill 接口，仅供存量部署使用
# ORGANIZATION_MODE=true 时启用历史组织集成；不要与 LOGIN_MODE=idaas_oauth 同时开启
ORGANIZATION_MODE=false

# 历史组织用户信息接口完整地址
ORG_USER_INFO_URL=

# 历史组织登录页地址（直接访问 /login 时跳转）
ORG_LOGIN_REDIRECT_URL=

# 历史组织 Skill 同步配置
ORG_SKILL_LIST_URL=
ORG_SKILL_DOWNLOAD_URL=
ORG_SKILL_DELETE_URL_BASE=
ORG_SKILL_INFO_URL=

# ------------------------------------------------------------
# Langfuse 配置（可选，用于 LangChain 调用追踪）
# ------------------------------------------------------------
# US 区域
LANGFUSE_PUBLIC_KEY=pk-lf-7dac9bbf-3e68-4d9b-9c95-8951c660219b
LANGFUSE_SECRET_KEY=sk-lf-220eaf18-e0b2-4e09-9680-e501af50ca5d
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# EU 区域（默认）
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ------------------------------------------------------------
# URL 前缀配置（用于嵌入其他网页时）
# ------------------------------------------------------------
# 设置后，所有 API 请求会自动添加此前缀
# 例如设置为 /skill-insight 后，API 请求会变成 /skill-insight/api/xxx
# 不设置或留空时，保持默认行为（/api/xxx）
NEXT_PUBLIC_URL_PREFIX=

# Benchmark 通信变量是进程启动兜底值。运行后可用
# ~/.agent-insight/data/config/benchmark-evaluator.env 热更新，无需重启 Agent Insight。
# 可选：仅覆盖下发给旧版本地执行器的回调地址；未配置时从请求地址自动推导
AGENT_INSIGHT_BENCHMARK_EXECUTOR_CALLBACK_BASE_URL=

# Agent Insight 向独立 Benchmark 评测服务下发任务；本机开发可填 http://127.0.0.1:3001
AGENT_INSIGHT_BENCHMARK_EVALUATOR_BASE_URL=

# 默认允许白名单、安全组或防火墙隔离网络中的 HTTP；设为 false 可强制非回环地址使用 HTTPS
AGENT_INSIGHT_BENCHMARK_EVALUATOR_ALLOW_INSECURE_HTTP=true

# 启动时自动准备的 Benchmark；留空时不自动准备。当前支持 swe-bench。
# 命令行 `--benchmark swe-bench` 可对单次启动覆盖此项。
AGENT_INSIGHT_BENCHMARK=

# SWE-bench Verified 来源；支持 HTTP(S) 下载直链或本机文件路径（推荐绝对路径）。
# AGENT_INSIGHT_BENCHMARK=swe-bench 时，脚本会自动下载、校验、安装并导入。
# 留空时使用官方来源；本机文件和下载文件均需通过固定的官方 SHA-256 校验。
# 数据集示例：http://intranet.example/test.parquet 或 /srv/datasets/test.parquet
# 源码示例：http://intranet.example/source.tar.gz 或 /srv/datasets/source.tar.gz
# 已导入的数据集优先复用；本机文件缺失或校验失败时直接报错，不覆盖原文件。
SWE_BENCH_DATASET_SOURCE=
SWE_BENCH_SOURCE_ARCHIVE_SOURCE=
# 可选：复用已有 Python 可执行文件；留空时自动创建官方 Loader 环境。
SWE_BENCH_PYTHON=

# SWE-bench Case Git 源码；配置在 Agent 执行客户端所在机器，不是 Evaluator 容器。
# 留空：Gitee → GitHub，不使用持久缓存。
# 本地 Bare 缓存根目录（如 /srv/swe-git）：本地 → Gitee → GitHub，未命中时按需补存。
# HTTP(S) Git 根地址（如 https://git.example.com）：根地址/owner/repo.git → Gitee → GitHub。
# 不接受 tar.gz；与上面的 SWE-bench Harness 源码归档不同。
SWE_BENCH_GIT_SOURCE=

# 独立 Benchmark Evaluator Controller 容器内部配置（与 Agent Insight 分开部署，不是宿主机对外端口）
# start-evaluator.sh 固定内部监听 8080；外部端口使用上面的 AGENT_INSIGHT_EVALUATOR_PORT。
EVALUATOR_LISTEN_HOST=0.0.0.0
EVALUATOR_PORT=8080
EVALUATOR_DATA_DIR=/data
EVALUATOR_MAX_CONCURRENCY=1
# 公共镜像池默认开启；需要覆盖配置时通过 --evaluator-env 传入，false 显式关闭。
IMAGE_POOL_ENABLED=true
IMAGE_POOL_PREFETCH_ENABLED=false
IMAGE_POOL_RESERVE_RATIO=0.3
IMAGE_POOL_HIGH_WATERMARK=0.9
IMAGE_POOL_MAX_PULLS=2
IMAGE_POOL_WAIT_SECONDS=600
# macOS Docker Desktop 可选：Docker.raw 所在文件系统上的空共享目录。
# 默认使用评测管理目录下的 space-probe；磁盘映像移到其他盘时需显式指定同盘目录。
# 仅由启动脚本消费，仍需通过 --evaluator-env 传入；不改变 Docker 磁盘映像位置。
IMAGE_POOL_MAC_DISK_PATH=
# 两端设置相同的随机密钥；只用于提前准备消息，不改变原评测通道的网络隔离要求
IMAGE_POOL_PREPARE_TOKEN=
BENCHMARK_IMAGE_POOL_PREPARE_TOKEN=
# 以下宿主事实由 scripts/start-evaluator.sh 检测并注入，不应手工伪造
EVALUATOR_HOST_OS=
EVALUATOR_HOST_ARCH=
EVALUATOR_SOURCE_REVISION=
EVALUATOR_SOURCE_DIRTY=false
EVALUATOR_CONTROLLER_IMAGE_ID=
SWE_BENCH_IMAGE_SOURCE=official
SWE_BENCH_IMAGE_ARCH=auto
SWE_BENCH_ALLOW_NON_OFFICIAL=false

# ------------------------------------------------------------
# 性能调优（可选，高级）
# ------------------------------------------------------------
# 评测中心 / 列表等接口（/api/observe/data → readRecords）按批加载每条 trace 的明细
# （session interactions + finalResult），这是每批的条数。
# 调小 → 峰值内存更低（内存吃紧的机器，如线上 119）；调大 → 批查询次数更少。
# 非法 / 不设置时默认 100。只影响峰值内存与查询次数，不改变返回结果。
# READ_RECORDS_HYDRATE_BATCH_SIZE=100

# ------------------------------------------------------------
# 管理员白名单（逗号分隔的用户名）。用于全局配置的编辑权限闸，
# 目前作用于「模型注册 → 模型单价」：只有白名单用户能在界面上修改模型单价，其他人只读。
# 不设置时默认仅平台默认账号 `admin` 为管理员。
#
# ⚠️ 平台用量统计（见下）对本变量的要求更严：必须显式配置且非空，
#    未配置时任何用户都看不到「用量统计」入口，管理 API 一律 403（fail-closed）。
# AGENT_INSIGHT_ADMIN_USERS=admin,you@example.com

# ------------------------------------------------------------
# 平台用量统计（管理员专用，默认关闭）
#
# 采集"有效使用"事件（用户主动触发且到达成功边界的行为），用于判断功能采用度。
# 页面进入、路由切换、重渲染、筛选、分页、轮询、后台任务与自动重试均不计数。
#
# 开关默认为 0：完成部署压测（scripts/benchmark_usage_analytics.ts）后再置 1。
# 关闭时不显示入口、不接收事件、不启动后台 flush，对现有业务零影响。
# AGENT_INSIGHT_USAGE_ENABLED=0

# 原始事件保留天数（默认 365）。日聚合永久保留，因此"全部"范围不受本项影响。
# 小于 1 的值按配置错误处理，回落默认值。
# AGENT_INSIGHT_USAGE_RAW_RETENTION_DAYS=365
