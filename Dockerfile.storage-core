FROM python:3.11-slim

WORKDIR /src
ENV PYTHONPATH=/src

COPY services/storage/ /src/services/storage/
RUN pip install --no-cache-dir -r /src/services/storage/requirements-relational.txt
COPY scripts/storage-core-docker-bootstrap.py /src/scripts/storage-core-docker-bootstrap.py

RUN mkdir -p /core && chown 1000:1000 /core

USER 1000:1000

VOLUME ["/core"]
