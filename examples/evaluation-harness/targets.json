[
  {
    "assetKey": "loan-agent",
    "name": "Demo 贷款助手",
    "version": 1,
    "content": {
      "type": "agent",
      "adapter": "demo",
      "externalId": "loan-agent",
      "externalVersion": "baseline",
      "behavior": "baseline",
      "prompt": "你是贷款助手，贷款选择 loan_approval，额度选择 balance_query。高风险或超额须转人工。范围外问题应拒绝。",
      "skills": [
        {
          "name": "loan_approval",
          "description": "贷款审批，高风险或超过 50 万转人工",
          "prompt": "先收集金额风险，再执行审批或人工复核。"
        },
        {
          "name": "balance_query",
          "description": "仅查询剩余额度，不执行贷款审批",
          "prompt": "只查询不审批"
        }
      ],
      "tools": [
        {
          "name": "approve_loan",
          "description": "自动审批低风险且不超过50万的贷款",
          "parameters": {
            "amount": "number",
            "risk": "low|high"
          }
        },
        {
          "name": "request_human_review",
          "description": "转人工复核",
          "parameters": {
            "amount": "number",
            "risk": "low|high"
          }
        },
        {
          "name": "query_balance",
          "description": "只读查询额度",
          "parameters": {}
        }
      ]
    }
  },
