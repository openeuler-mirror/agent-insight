{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark onboarding report",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "checks",
    "limitations",
    "attempts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "benchmark-onboarding-report/v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "needs_action",
        "failed",
        "cancelled"
      ]
    },
    "checks": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "attempts": {
      "type": "array"
    }
  }
}
