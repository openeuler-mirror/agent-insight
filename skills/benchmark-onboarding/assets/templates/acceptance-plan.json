  "baseline": {
    "argv": [],
    "cwd": "{repo}",
    "timeoutSeconds": 120
  },
  "tolerances": {},
  "checks": [
    {
      "id": "source",
      "category": "source",
      "required": true,
      "argv": [],
      "cwd": "{repo}",
      "timeoutSeconds": 120,
      "resultMode": "check"
