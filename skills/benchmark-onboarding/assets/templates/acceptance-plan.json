{
  "schemaVersion": "benchmark-onboarding-plan/v1",
  "benchmarkKey": "replace-me",
  "scope": {
    "label": "至少 3 个、通常 3–5 个跨类型真实 Case；分类与选样依据见验证矩阵",
    "mode": "fixture",
    "caseIds": [
      "replace-case-id-type-a",
      "replace-case-id-type-b",
      "replace-case-id-type-c"
    ]
  },
  "source": {
    "url": "https://example.org/benchmark",
    "codeRevision": "replace-with-pinned-revision",
    "dataRevision": "replace-with-data-revision",
    "split": "replace-with-split",
    "license": "replace-with-verified-license",
