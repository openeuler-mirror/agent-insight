# Copy to `.env` (next to the example scripts) and fill in. NEVER commit the real .env.

# ---- LLM (the jiuwen agents call this) ----
MODEL_PROVIDER=OpenAI
API_BASE=https://api.deepseek.com
API_KEY=                      # <-- your LLM key (DeepSeek used in the spike)
MODEL_NAME=deepseek-v4-flash
LLM_SSL_VERIFY=False

# ---- where to push the OTLP spans (= your agent-insight dev OTEL endpoint) ----
INSIGHT_OTLP=http://localhost:3011/api/ingest/otel/v1/traces
